# forge-webapi environment — copy to `.env` and set real values.
# `.env` is gitignored; never commit real credentials.
#
# SurrealDB root credentials. There are NO defaults: the API refuses to start
# without SURREAL_PASSWORD, and SurrealDB will not start without --user/--pass.
# Use a long random password, e.g. `openssl rand -base64 32`.
SURREAL_USER=forge_admin
SURREAL_PASSWORD=change-me-to-a-long-random-password

# SurrealDB namespace/database the API selects after connecting.
SURREAL_NAMESPACE=forge
SURREAL_DATABASE=main
